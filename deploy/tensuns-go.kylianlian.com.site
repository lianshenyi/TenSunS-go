# /etc/nginx/site-enable/tensuns-go.kylianlian.com.site
#
# tensuns-go.kylianlian.com → TenSunS-go 前端 + /api 反代 (10.0.10.236:1026)
#
# 2026-10-24 新增：TenSunS-go 阶段一至三验收通过（HEAD f249639）后配置。
# 前端容器 tensuns-go-web 自带 nginx，既提供 Vue 静态文件，也把 /api/ 反代到
# 同网络的 tensuns-go-api:2026，因此这里只反代 1026 一个入口即可。

server {
    listen      80;
    server_name tensuns-go.kylianlian.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen      443 ssl http2;
    server_name tensuns-go.kylianlian.com;

    ssl_certificate     /etc/nginx/ssl/kylianlian.com/kylianlian.com.cert.pem;
    ssl_certificate_key /etc/nginx/ssl/kylianlian.com/kylianlian.com.key.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log /var/log/nginx/kylianlian.com.access.log;
    error_log  /var/log/nginx/kylianlian.com.error.log;

    location / {
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;

        proxy_connect_timeout 60s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;

        proxy_pass http://10.0.10.236:1026;
    }
}
