# Copy to .env and edit before running `docker compose up -d --build`.
# .env is git-ignored; never commit real credentials.
#
# Recommended: `make env-init` (or ./scripts/gen-env.sh) — it copies this file
# to .env and fills in random values for the three secrets below, then sets
# .env permissions to 600. `cp .env.example .env` also works, but then the
# placeholders below must be replaced by hand.

# --- Consul ACL ---------------------------------------------------------------
# consul_management_token bootstraps the Consul ACL system (initial_management
# + agent token). consul_token is what the Go API sends as X-Consul-Token.
# The two MUST be identical: the ACL default policy is "deny".
# Generated automatically by scripts/gen-env.sh (UUID v4).
consul_management_token=REPLACE-WITH-UUID
consul_token=REPLACE-WITH-UUID

# --- Application --------------------------------------------------------------
# Login password for the built-in admin account.
# Generated automatically by scripts/gen-env.sh (24 hex chars).
admin_passwd=tensuns

# --- Ports --------------------------------------------------------------------
# Consul HTTP API. Keep it on loopback unless remote management is required.
consul_http_bind=127.0.0.1
consul_http_port=18500
api_http_bind=0.0.0.0
api_http_port=2026
web_http_bind=0.0.0.0
web_http_port=1026

# --- Runtime ------------------------------------------------------------------
TZ=Asia/Shanghai
log_level=INFO
# Set to 0 to enable the scheduler. Cloud/JMS adapters are not wired yet, so
# scheduled jobs log errors; keep this at 1 until the adapters land.
scheduler_disabled=1

# --- Build --------------------------------------------------------------------
version=dev
commit=unknown
build_date=unknown
image_tag=latest
node_image=node:14-alpine
nginx_image=nginx:1.24-alpine
